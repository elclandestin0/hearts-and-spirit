  - clip: {fileID: 8300000, guid: 49fa0c76629a240469cddc5c7e80b49d, type: 3}
    text: Oh, Lord!
  - clip: {fileID: 8300000, guid: 7432ad6d22d6f4fed949b2e02ffa7726, type: 3}
    text: Oops!
  - clip: {fileID: 8300000, guid: ae7a91c7a65e0458baecd2b766eac774, type: 3}
    text: Oopa! Hehehe.
  - clip: {fileID: 8300000, guid: 22a9c081a814a4a83a38439b2650408b, type: 3}
    text: It's lit!
  - clip: {fileID: 8300000, guid: 50939395cb0a34f1085d07443811d0c0, type: 3}
