  - clip: {fileID: 8300000, guid: 4d9d0b05c561146f5bed134d758c61a7, type: 3}
    text: Light it up!
  - clip: {fileID: 8300000, guid: e229bcb4983834554940317e9817ea3b, type: 3}
    text: 'It''s lit! '
  - clip: {fileID: 8300000, guid: 306a427bcc26941998596630f2de0415, type: 3}
    text: Beautiful!
  - clip: {fileID: 8300000, guid: fde8162ff8f3c47f5835e1fc0afe50cb, type: 3}
    text: Beautiful!
  - clip: {fileID: 8300000, guid: bdf1a0431d871467e968a45a4ca06aba, type: 3}
