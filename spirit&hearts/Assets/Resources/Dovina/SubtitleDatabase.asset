  - clip: {fileID: 8300000, guid: a7de8263f6026460da134b074c648fb4, type: 3}
    text: On we go!
  - clip: {fileID: 8300000, guid: 4c6ba1bfc32af4220afeb592a5c68191, type: 3}
    text: Cool, we can hang out here for a bit.
  - clip: {fileID: 8300000, guid: e7f6924c42521406b98f6efb484db4ad, type: 3}
    text: Yeah, let's stay here.
  - clip: {fileID: 8300000, guid: 64a576f952aff474e8cef29f3ba770c5, type: 3}
